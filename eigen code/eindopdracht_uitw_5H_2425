var appel = {
  x:50,
  y:100,
  sprite:null,
  snelheidX:8,
  snelheidY:5,

  beweeg(){
    this.x += this.snelheidX;
    this.y += this.snelheidY;

    if (this.x < 0 || this.x > canvas.width - this.sprite.width) {
      this.snelheidX *= -1;
    }
    if (this.y < 0 || this.y > canvas.height - this.sprite.height) {
      this.snelheidY *= -1;
    }
  },

  toon() {
    image(this.sprite, this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

//nieuwe klasse
class Bom {
  constructor(x,s) {
    this.x = x;
    this.y = 0;
    this.richting = 1;
    this.snelheid = s;
    this.sprite = null;
  }

  beweeg() {
    this.y += this.snelheid * this.richting;

    this.y = constrain(this.y, 0, canvas.height - raster.celGrootte);

    if ((this.y == 0) || (this.y == canvas.height - raster.celGrootte)) {
      this.richting = -1 * this.richting;
    }
  }

  toon() {
    image(this.sprite, this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

class Raster {
  constructor(r, k) {
    this.aantalRijen = r;
    this.aantalKolommen = k;
    this.celGrootte = null;
  }

  berekenCelGrootte() {
    this.celGrootte = canvas.width / this.aantalKolommen;
  }

  teken() {
    push();
    noFill();
    stroke('grey');
    for (var rij = 0; rij < this.aantalRijen; rij++) {
      for (var kolom = 0; kolom < this.aantalKolommen; kolom++) {
        if (rij == 4 || kolom == 3){
          fill("orange");
        }
        else {
          noFill();
        }
        rect(kolom * this.celGrootte, rij * this.celGrootte, this.celGrootte, this.celGrootte);
      }
    }
    pop();
  }
}

class Jos {
  constructor() {
    this.x = 400;
    this.y = 300;
    this.animatie = [];
    this.frameNummer = 3;
    this.stapGrootte = null;
    this.gehaald = false;
    // nieuwe levens
    this.levens = 1;
  }

  beweeg() {
    // besturing met WASD ipv pijltoetsen
    if (keyIsDown(65)) {
      this.x -= this.stapGrootte;
      this.frameNummer = 2;
    }
    if (keyIsDown(68)) {
      this.x += this.stapGrootte;
      this.frameNummer = 1;
    }
    if (keyIsDown(87)) {
      this.y -= this.stapGrootte;
      this.frameNummer = 4;
    }
    if (keyIsDown(83)) {
      this.y += this.stapGrootte;
      this.frameNummer = 5;
    }

    this.x = constrain(this.x, 0, canvas.width);
    this.y = constrain(this.y, 0, canvas.height - raster.celGrootte);

    if (this.x == canvas.width) {
      this.gehaald = true;
    }
  }

  wordtGeraakt(vijand) {
    if (this.x == vijand.x && this.y == vijand.y) {
      return true;
    }
    else {
      return false;
    }
  }

  // nieuwe method
  botstOpBom() {
    if ((this.x == bom1.x && this.y == bom1.y) || (this.x == bom2.x && this.y == bom2.y)) {
      return true;
    }
    else {
      return false;
    }
  }

  toon() {
    image(this.animatie[this.frameNummer], this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

class Vijand {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.sprite = null;
    this.stapGrootte = null;
  }

  beweeg() {
    this.x += floor(random(-1, 2)) * this.stapGrootte;
    this.y += floor(random(-1, 2)) * this.stapGrootte;

    this.x = constrain(this.x, 0, canvas.width - raster.celGrootte);
    this.y = constrain(this.y, 0, canvas.height - raster.celGrootte);
  }

  toon() {
    image(this.sprite, this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

function preload() {
  brug = loadImage("images/backgrounds/dame_op_brug_1800.jpg");
  appel.sprite = loadImage("images/sprites/appel_2.png");
  //bom=loadImage("images/sprites/bom.png");
}

function setup() {
  canvas = createCanvas(900, 600);
  canvas.parent();
  frameRate(20);
  textFont("Verdana");
  textSize(90);

  // kleinere hokjes 12x18
  raster = new Raster(12, 18);
  raster.berekenCelGrootte();

  eve = new Jos();
  eve.stapGrootte = 1 * raster.celGrootte;
  for (var b = 0; b < 6; b++) {
    frameEve = loadImage("images/sprites/Eve100px/Eve_" + b + ".png");
    eve.animatie.push(frameEve);
  }

  alice = new Vijand(700, 200);
  alice.stapGrootte = 1 * eve.stapGrootte;
  alice.sprite = loadImage("images/sprites/Alice100px/Alice.png");

  bob = new Vijand(600, 400);
  bob.stapGrootte = 1 * eve.stapGrootte;
  bob.sprite = loadImage("images/sprites/Bob100px/Bob.png");

  //bom op random x, veelvoud van celgrootte, rechts vh midden
  //bomb.x=floor(random(0,width/100))*100;
  //bomb.sprite=bom;
  bom1 = new Bom(floor(random()*10)*50+400,10);
  bom1.sprite = loadImage("images/sprites/bom_100px.png");
  bom2 = new Bom(floor(random()*10)*50+400,20);
  bom2.sprite = loadImage("images/sprites/bom_100px.png");
}

function draw() {
  background(brug);
  raster.teken();
  // kleine letters push/pop gebruiken
  push();
  textFont("Arial");
  textSize(20);
  text("Levens: " + eve.levens, 10, 50);
  pop();
  eve.beweeg();
  alice.beweeg();
  bob.beweeg();
  bom1.beweeg();
  bom2.beweeg();
  appel.beweeg();

  eve.toon();
  alice.toon();
  bob.toon();
  bom1.toon();
  bom2.toon();
  appel.toon();

  if (eve.wordtGeraakt(alice) || eve.wordtGeraakt(bob) || eve.botstOpBom()) {
    eve.levens -= 1;
    if (eve.levens == 0) {
      //background('green');
      //fill('white');
      //text("Je hebt verloren ;-(",30,300);
      eindscherm("verlies");
      noLoop();
    }
  }

  if (eve.gehaald) {
    //background('green');
    //fill('white');
    //text("Je hebt gewonnen!",30,300);
    eindscherm("winst");
    noLoop();
  }
}

