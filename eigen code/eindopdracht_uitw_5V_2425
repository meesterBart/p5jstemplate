class Raster {
  constructor(r, k) {
    this.aantalRijen = r;
    this.aantalKolommen = k;
    this.celGrootte = null;
  }

  berekenCelGrootte() {
    this.celGrootte = canvas.width / this.aantalKolommen;
  }

  teken() {
    push();
    noFill();
    stroke('grey');
    
    for (var rij = 0; rij < this.aantalRijen; rij++) {
      for (var kolom = 0; kolom < this.aantalKolommen; kolom++) {
        if (rij == 4 || kolom == 3) {
          fill("orange");
        }
        else {
          noFill();
          if ((mouseX > 3*this.celGrootte && mouseX < 4*this.celGrootte)||
          (mouseY > 4*this.celGrootte && mouseY < 5*this.celGrootte)){
            fill("blue");
          }
        }
        rect(kolom * this.celGrootte, rij * this.celGrootte, this.celGrootte, this.celGrootte);
      }
    }
    pop();
  }
}

class Jos {
  constructor() {
    this.x = 400;
    this.y = 300;
    this.animatie = [];
    this.frameNummer = 3;
    this.stapGrootte = null;
    this.gehaald = false;
    // nieuw attribuut
    this.levens = 1;
  }

  beweeg() {
    if (keyIsDown(65)) {
      this.x -= this.stapGrootte;
      this.frameNummer = 2;
    }
    if (keyIsDown(68)) {
      this.x += this.stapGrootte;
      this.frameNummer = 1;
    }
    if (keyIsDown(87)) {
      this.y -= this.stapGrootte;
      this.frameNummer = 4;
    }
    if (keyIsDown(83)) {
      this.y += this.stapGrootte;
      this.frameNummer = 5;
    }

    this.x = constrain(this.x, 0, canvas.width);
    this.y = constrain(this.y, 0, canvas.height - raster.celGrootte);

    if (this.x == canvas.width) {
      this.gehaald = true;
    }
  }

  wordtGeraakt(vijand) {
    if (this.x == vijand.x && this.y == vijand.y) {
      return true;
    }
    else {
      return false;
    }
  }

  // nieuwe method
  // omdat bommen niet netjes in een kolom bewegen moet je een range checken voor de botsing. let op bom.sprite.width want bom.width werkt niet
  botstOpBom(bom) {
    if (this.x > bom.x && (this.x < bom.x + bom.sprite.width) && this.y > bom.y && (this.y < bom.y + bom.sprite.height)) {
      return true;
    }
    else {
      return false;
    }
  }

  // nieuwe methode
  // let op dat levens niet blijft oplopen bij eten appel
  eetAppel() {
    if (this.x == appel1.x && this.y == appel1.y && !appel1.gegeten) {
      this.levens+=1;
      appel1.gegeten=true;
    }
    if ((this.x > appel2.x && this.x < appel2.x+appel2.sprite.width) && (this.y > appel2.y && this.y < appel2.y+appel2.sprite.height) && !appel2.gegeten){
      this.levens+=1;
      appel2.gegeten=true;
    }
  }

  toon() {
    image(this.animatie[this.frameNummer], this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

class Vijand {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.sprite = null;
    this.stapGrootte = null;
  }

  beweeg() {
    this.x += floor(random(-1, 2)) * this.stapGrootte;
    this.y += floor(random(-1, 2)) * this.stapGrootte;

    this.x = constrain(this.x, 0, canvas.width - raster.celGrootte);
    this.y = constrain(this.y, 0, canvas.height - raster.celGrootte);
  }

  toon() {
    image(this.sprite, this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

// new var appel
var appel1 = {
  // attributen
  x: 200,
  y: 400,
  sprite: null,
  // extra attribuut dat zorgt dat appel maar 1x keer opgegeten kan worden
  gegeten: false,

  //methoden
  toon() {
    image(this.sprite, this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

var appel2 = {
  // attributen
  x: 300,
  y: 300,
  sprite: null,
  snelheidX: 5,
  snelheidY: 5,
   // extra attribuut dat zorgt dat appel maar 1x keer opgegeten kan worden
  gegeten: false,

  //methoden
  toon() {
    image(this.sprite, this.x, this.y, raster.celGrootte, raster.celGrootte);
  },

  // gaat rondstuiteren in canvas
  beweeg() {
    this.x += this.snelheidX;
    this.y += this.snelheidY;
    if (this.x < 0 || this.x > canvas.width - raster.celGrootte) {
      this.snelheidX *= -1;
    }
    if (this.y < 0 || this.y > canvas.height - raster.celGrootte) {
      this.snelheidY *= -1;
    }
  }
}

// new class Bom
class Bom {
  constructor(x, s) {
    this.x = x;
    this.y = 0;
    this.richting = 1;
    this.snelheid = s;
    //this.sprite = null;
    this.sprite = loadImage("images/sprites/bom.png");
    // dit attribuut zorgt dat elke bom maar 1x ontploft
    this.ontploft = false;
  }

  beweeg() {
    this.y += this.snelheid * this.richting;

    this.y = constrain(this.y, 0, canvas.height - raster.celGrootte);

    if ((this.y == 0) || (this.y == canvas.height - raster.celGrootte)) {
      this.richting = -1 * this.richting;
    }
  }

  toon() {
    image(this.sprite, this.x, this.y, raster.celGrootte, raster.celGrootte);
  }
}

function preload() {
  brug = loadImage("images/backgrounds/dame_op_brug_1800.jpg");
  // onderstaande werkt niet in object appel
  // rode appel
  appel1.sprite = loadImage("images/sprites/appel_2.png");
  // groene appel
  appel2.sprite = loadImage("images/sprites/appel_1.png");
}

var bommen = [];

function setup() {
  canvas = createCanvas(900, 600);
  canvas.parent();
  frameRate(10);
  textFont("Verdana");
  textSize(90);

  raster = new Raster(12, 18);

  raster.berekenCelGrootte();

  eve = new Jos();
  eve.stapGrootte = 1 * raster.celGrootte;
  for (var b = 0; b < 6; b++) {
    frameEve = loadImage("images/sprites/Eve100px/Eve_" + b + ".png");
    eve.animatie.push(frameEve);
  }

  alice = new Vijand(700, 200);
  alice.stapGrootte = 1 * eve.stapGrootte;
  alice.sprite = loadImage("images/sprites/Alice100px/Alice.png");

  bob = new Vijand(600, 400);
  bob.stapGrootte = 1 * eve.stapGrootte;
  bob.sprite = loadImage("images/sprites/Bob100px/Bob.png");

  // array maken werkt hier niet. staat buiten/boven setup()
  //var bommen = [];
  for (var n = 0; n < 5; n++) {
    // plaats elke bom rechts van het midden
    random_xpos = random(width / 2, width - raster.celGrootte);
    // en geef een willekeurige snelheid tussen 0-10
    random_speed = random(10);
    // maak het array met bommen
    bommen.push(new Bom(random_xpos, random_speed));
  }
}

function draw() {
  background(brug);
  raster.teken();
  //zet linksboven het aantal levens
  // bewaar tekensettings
  push();
  textSize(12);
  text("Aantal levens resterend: " + eve.levens, eve.x, 50);
  pop();
  //testregels
  //text("eve X: "+eve.x+" eve Y: "+eve.y,50,50);
  //text("bom X: "+bommen[0].x+" bom Y: "+bommen[0].y+" width: "+bommen[0].sprite.width,50,80);
  // herstel tekensettings
  eve.beweeg();
  alice.beweeg();
  bob.beweeg();
  eve.toon();
  alice.toon();
  bob.toon();

  // appel die opgegeten is niet meer tonen
  //if (!appel.gegeten){}
  if (appel1.gegeten == false) {
    appel1.toon();
  }

  if (appel2.gegeten == false) {
    appel2.beweeg();
    appel2.toon();
  }
  
  // beweeg en toon alle bommen
  // bommen die opgegeten zijn niet meer tonen
  for (var n = 0; n < 5; n++) {
    if (!bommen[n].ontploft) {
      bommen[n].beweeg();
      bommen[n].toon();
    }
  }

  if (eve.wordtGeraakt(alice) || eve.wordtGeraakt(bob)) {
    eve.levens-=1;
    if (eve.levens == 0) {
      background('red');
      fill('white');
      text("Op obstakel geknald!", 30, 300);
      noLoop();
    }
  }

  for (var n = 0; n < 5; n++) {
    if (eve.botstOpBom(bommen[n]) && !bommen[n].ontploft) {
      bommen[n].ontploft = true;
      eve.levens -= 1;
      if (eve.levens == 0) {
        background('red');
        fill('white');
        text("Bom ontploft!", 30, 300);
        noLoop();
      }
    }
  }

  //if (eve.eetAppel() && !appel1.gegeten) {
  //  eve.levens += 1;
  //  appel1.gegeten = true;
  //}
  eve.eetAppel();

  if (eve.gehaald) {
    eindscherm("Je hebt gewonnen!", "green");
    //  background('green');
    //  fill('white');
    //  text("Je hebt gewonnen!",30,300);
    //  noLoop();
  }
}

// aparte functie voor eindscherm in alle gevallen
function eindscherm(tekst, kleur) {
  background(kleur);
  fill('white');
  text(tekst, 30, 300);
  noLoop();
}